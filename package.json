{
  "name": "simulator-beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --enable-source-maps --loader ts-node/esm src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:check": "node scripts/check-contracts.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@microsoft/signalr": "8.0.7",
    "fastify": "^4.29.1",
    "jose": "^6.2.12",
    "pg": "8.13.1",
    "pg-connection-string": "2.14.0",
    "pino": "9.5.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ts-node": "10.9.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
