{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "event": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "year": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "statusId": {
          "type": "integer"
        },
        "scheduledAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "wentLiveAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "fundsPercent": {
          "type": "integer"
        },
        "routeImageMediaId": {
          "type": [
            "string",
            "null"
          ]
        },
        "flightHistory": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "routeId": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  },
                  "recordedAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "latestMessage": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "body": {
              "type": "string"
            },
            "eventTime": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "websiteUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "fbUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "igUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "logoMediaId": {
            "type": [
              "string",
              "null"
            ]
          },
          "latestYear": {
            "type": "integer"
          },
          "yearsAsSponsor": {
            "type": "integer"
          },
          "lingerMs": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "cookieTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "sort": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "content": true,
    "media": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          },
          "alt": {
            "type": "string"
          },
          "variants": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "dzi": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}